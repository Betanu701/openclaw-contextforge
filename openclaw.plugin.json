{
  "id": "contextforge",
  "commandAliases": [
    {
      "name": "cf"
    }
  ],
  "activation": {
    "onStartup": true,
    "onCommands": [
      "cf"
    ]
  },
  "kind": "memory",
  "contracts": {
    "tools": [
      "contextforge_recall",
      "contextforge_context",
      "contextforge_remember",
      "contextforge_permanent_context",
      "contextforge_ingest",
      "contextforge_session",
      "contextforge_forget",
      "contextforge_chat",
      "contextforge_analyze",
      "contextforge_stats"
    ]
  },
  "uiHints": {
    "serviceUrl": {
      "label": "ContextForge service URL",
      "placeholder": "http://contextforge:8765",
      "help": "HTTP URL for the ContextForge sidecar"
    },
    "namespacePrefix": {
      "label": "Namespace prefix",
      "placeholder": "openclaw",
      "advanced": true,
      "help": "Prefix added before user/session identifiers to prevent cross-application memory mixing"
    },
    "autoRecall": {
      "label": "Auto-recall",
      "help": "Automatically inject relevant ContextForge memories into each prompt"
    },
    "autoCapture": {
      "label": "Explicit auto-capture",
      "help": "Capture user turns that contain configured remember/save trigger phrases"
    },
    "recallMaxTokens": {
      "label": "Recall max tokens",
      "placeholder": "4096",
      "advanced": true,
      "help": "Hard token envelope sent to the ContextForge planner for automatic prompt context"
    },
    "autoRecallLimit": {
      "label": "Auto-recall source limit",
      "placeholder": "8",
      "advanced": true,
      "help": "Maximum number of ContextForge sources automatically injected into a prompt"
    },
    "recallMaxChars": {
      "label": "Recall query max chars",
      "placeholder": "2000",
      "advanced": true
    },
    "captureMaxChars": {
      "label": "Capture max chars",
      "placeholder": "4000",
      "advanced": true
    },
    "autoRecallTimeoutMs": {
      "label": "Auto-recall timeout",
      "placeholder": "750",
      "advanced": true
    },
    "timeoutMs": {
      "label": "Tool timeout",
      "placeholder": "5000",
      "advanced": true
    },
    "category": {
      "label": "Default category",
      "placeholder": "openclaw",
      "advanced": true
    },
    "includePermanentContext": {
      "label": "Include permanent context",
      "advanced": true,
      "help": "Include namespace-scoped permanent ContextForge context in automatic prompt injection"
    },
    "allowedCategories": {
      "label": "Allowed context categories",
      "advanced": true,
      "help": "Optional allow-list for categories that can be injected into prompt context"
    },
    "blockedCategories": {
      "label": "Blocked context categories",
      "advanced": true,
      "help": "Categories that must never be injected into prompt context"
    },
    "minScore": {
      "label": "Minimum recall score",
      "placeholder": "0",
      "advanced": true
    },
    "maxSourceTokens": {
      "label": "Max tokens per source",
      "placeholder": "768",
      "advanced": true,
      "help": "Per-source packing target; oversized sources are query-compacted by ContextForge when possible"
    },
    "autoCaptureTriggers": {
      "label": "Auto-capture trigger phrases",
      "advanced": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serviceUrl": {
        "type": "string"
      },
      "namespacePrefix": {
        "type": "string"
      },
      "autoRecall": {
        "type": "boolean"
      },
      "autoCapture": {
        "type": "boolean"
      },
      "recallMaxTokens": {
        "type": "number",
        "minimum": 256,
        "maximum": 65536
      },
      "autoRecallLimit": {
        "type": "number",
        "minimum": 1,
        "maximum": 50
      },
      "recallMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 20000
      },
      "captureMaxChars": {
        "type": "number",
        "minimum": 100,
        "maximum": 20000
      },
      "autoRecallTimeoutMs": {
        "type": "number",
        "minimum": 100,
        "maximum": 10000
      },
      "timeoutMs": {
        "type": "number",
        "minimum": 500,
        "maximum": 60000
      },
      "category": {
        "type": "string"
      },
      "includePermanentContext": {
        "type": "boolean"
      },
      "allowedCategories": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "blockedCategories": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "minScore": {
        "type": "number",
        "minimum": 0,
        "maximum": 1000000
      },
      "maxSourceTokens": {
        "type": "number",
        "minimum": 1,
        "maximum": 65536
      },
      "autoCaptureTriggers": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    }
  }
}
