{
  plugins: {
    enabled: true,
    load: {
      paths: ["/plugins/contextforge"]
    },
    entries: {
      contextforge: {
        enabled: true,
        hooks: {
          allowPromptInjection: true,
          allowConversationAccess: true
        },
        config: {
          serviceUrl: "${CONTEXTFORGE_SERVICE_URL}",
          namespacePrefix: "openclaw",
          autoRecall: true,
          autoCapture: true,
          recallMaxTokens: 4096,
          autoRecallLimit: 6,
          includePermanentContext: true,
          allowedCategories: ["openclaw", "_permanent_context"],
          blockedCategories: [],
          maxSourceTokens: 768,
          autoRecallTimeoutMs: 750,
          category: "openclaw"
        }
      },
      "memory-lancedb": {
        enabled: false
      },
      "active-memory": {
        enabled: false
      }
    },
    slots: {
      memory: "contextforge"
    }
  }
}
